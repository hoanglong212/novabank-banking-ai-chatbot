{
  "name": "novabank-banking-chatbot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:ocr && vite --host 127.0.0.1",
    "build": "npm run prepare:ocr && tsc -b && vite build",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:components": "node scripts/check-components.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "lottie-web": "5.13.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "6.4.5"
  },
  "overrides": {
    "postcss-selector-parser@<6.1.5": "6.1.5"
  }
