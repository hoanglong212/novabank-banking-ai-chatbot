# Optional research adapter settings. The running Agent uses Ollama.
# Copy to research/.env for approved experiments and pass that path explicitly.
# Offline check from the repository root:
# python -m research.api_adapter --env-file research/.env
RESEARCH_API_BASE_URL=https://provider.invalid/v1
RESEARCH_API_MODEL=<API_MODEL>
RESEARCH_API_KEY=
RESEARCH_API_SUPPORTS_SEED=false
