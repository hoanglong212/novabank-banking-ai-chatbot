# Local-only education demo. NEVER deploy bundled demo credentials.
# mock (offline script) | ollama (bound tool proposals) | langgraph (LangGraph agent on Ollama)
LLM_PROVIDER=mock
# qwen2.5:7b (recommended, ~5 GB VRAM) follows tool and safety rules far better than llama3.2:3b.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
GATEWAY_MODE=local
# Proposed adapter contract; only enable after matching your team's real API.
GATEWAY_URL=
DB_PATH=./novabank_demo.sqlite3
# Optional: absolute path to frontend/dist for single-port serving.
# The demo launcher and Docker image set this automatically.
# FRONTEND_DIST=
# Optional VietQR API credentials (https://my.vietqr.io). Without them the public
# img.vietqr.io Quick Link renders the same NAPAS QR.
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
# HS256 signing key for login JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a random key is used per process and every restart signs users out.
JWT_SECRET=
JWT_TTL_MINUTES=60
