# Local-only education demo. Run scripts/init-demo-auth.py to generate local credentials.
LLM_PROVIDER=mock
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=60m
GATEWAY_MODE=local
# Proposed adapter contract; only enable after matching your team's real API.
GATEWAY_URL=
DB_PATH=./novabank_demo.sqlite3
# Optional: absolute path to frontend/dist for single-port serving.
# The demo launcher and Docker image set this automatically.
# FRONTEND_DIST=

# Required, random >=32 bytes; never commit real values.
JWT_SECRET=
DEMO_ALICE_PASSWORD=
DEMO_BOB_PASSWORD=
SESSION_TTL_SECONDS=3600
# Keep true on HTTPS. init-demo-auth.py sets false ONLY for HTTP loopback development.
AUTH_COOKIE_SECURE=true
APP_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:5173,http://localhost:5173
