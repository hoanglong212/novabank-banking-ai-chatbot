# Local-only education demo. NEVER deploy bundled demo credentials.
# mock (offline script) | ollama (bound tool proposals) | langgraph (LangGraph agent on Ollama)
LLM_PROVIDER=mock
# qwen2.5:7b (recommended, ~5 GB VRAM) follows tool and safety rules far better than llama3.2:3b.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
GATEWAY_MODE=local
# Proposed adapter contract; only enable after matching your team's real API.
GATEWAY_URL=
DB_PATH=./novabank_demo.sqlite3
# Optional: absolute path to frontend/dist for single-port serving.
# The demo launcher and Docker image set this automatically.
# FRONTEND_DIST=
# Internal signed NovaBank QR only. No external bank/QR service is called.
AGENT_SERVICE_URL=http://127.0.0.1:8093
EMBEDDING_MODEL=nomic-embed-text:latest
BANK_WORKER_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The launcher starts both processes. Do not enable LEGACY_AGENT_TEST_MODE in deployment.
# HS256 signing key for login JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a random key invalidates old access JWTs and pending email codes on restart.
# Persisted, unexpired refresh credentials can still obtain a new access JWT.
JWT_SECRET=
# Access JWTs last 5 minutes; idle sessions 5 minutes; absolute sessions 8 hours.
# Optional Fernet key for authenticator seeds. If empty, a per-DB .mfa.key file is generated.
# Keep that key with database backups; do not commit it.
MFA_ENCRYPTION_KEY=
RESEARCH_SANDBOX_ENABLED=false
