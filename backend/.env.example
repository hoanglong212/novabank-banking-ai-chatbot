# Windows native launcher. -Setup copies this to backend/.env if it is absent.
# Docker Compose uses the templates at the repository root instead.

# Enables the simulated inbox for local development.
ENV=demo
# The launcher's -Mode ollama or -Mode mock overrides this value for that run.
LLM_PROVIDER=mock
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
GUARD_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text:latest
QUARANTINED_LLM_MODEL=llama3.2:3b

# Under run-demo.ps1, a relative database path is resolved from backend/.
DB_PATH=./novabank_demo.sqlite3
AGENT_SERVICE_URL=http://127.0.0.1:8093
BANK_WORKER_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FRONTEND_DIST is set by the launcher. For manual serving, use an absolute path.
# FRONTEND_DIST=

# Adapter settings for teams with a compatible external banking API.
GATEWAY_MODE=local
GATEWAY_URL=
RESEARCH_SANDBOX_ENABLED=false

# HS256 signing key for login JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a new signing key invalidates old access JWTs on restart.
# Persisted, unexpired refresh credentials can still obtain a new access JWT.
JWT_SECRET=
# One key per purpose (R8); generate each like JWT_SECRET. Empty = random per process, so a restart
# invalidates demo QR codes, pending OTPs and open transfer confirmations.
QR_SIGNING_KEY=
OTP_HASH_KEY=
TRANSFER_TOKEN_KEY=
# Access JWTs last 5 minutes; idle sessions 5 minutes; absolute sessions 8 hours.
# Optional Fernet key for authenticator seeds. If empty, a per-DB .mfa.key file is generated.
# Keep that key with database backups; do not commit it.
MFA_ENCRYPTION_KEY=

# Optional licensed Prompt Guard 2. Provide an absolute path when provisioned.
PROMPT_GUARD_MODEL_PATH=
PROMPT_GUARD_THRESHOLD=0.5
PROMPT_GUARD_TIMEOUT_SECONDS=5
