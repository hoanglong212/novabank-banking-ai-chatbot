FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY agent_service/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && useradd --uid 10002 --create-home agent
COPY agent_service/ /app/agent_service/
USER agent
EXPOSE 8093
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8093/health', timeout=3)"
CMD ["python", "-m", "uvicorn", "agent_service.main:app", "--host", "0.0.0.0", "--port", "8093"]
