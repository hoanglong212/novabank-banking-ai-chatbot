# Workstation Docker Compose defaults. Copy to .env only to override a setting.
# docker compose -f compose.local.yaml up -d --build
# For a shared HTTPS demo, use .env.hosted.example.

NOVABANK_PORT=8080

# ollama runs a real model. mock uses labeled demo responses without model weights.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
GUARD_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text:latest
QUARANTINED_LLM_MODEL=llama3.2:3b
OLLAMA_IMAGE=ollama/ollama:latest

# Optional signing key for access tokens. Generate your own value if needed.
# JWT_SECRET=

# Required only with the compose.prompt-guard.yaml overlay.
# PROMPT_GUARD_MODEL_DIR=/absolute/host/path/to/prompt-guard-2-86m
