# Optional overrides for the workstation stack (compose.local.yaml).
# NOVABANK_PORT=8080
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b
# GUARD_MODEL=qwen2.5:7b
# EMBEDDING_MODEL=nomic-embed-text:latest
# QUARANTINED_LLM_MODEL=llama3.2:3b
# OLLAMA_IMAGE=ollama/ollama:latest

# Required when hosting a restricted review URL (compose.yaml).
# Set these in a private .env file. See docs/release/DEPLOYMENT.md.
# DEMO_DOMAIN=review.example.com
# ACME_EMAIL=operator@example.com
# DEMO_ALLOWED_NETWORKS="203.0.113.10/32 198.51.100.0/24"
# JWT_SECRET=
# BACKUP_KEY_FILE=
# Change both only if the private proxy network overlaps an existing network.
# NOVABANK_PROXY_SUBNET=172.31.86.0/28
# NOVABANK_PROXY_IP=172.31.86.2

# Optional when adding compose.prompt-guard.yaml.
# PROMPT_GUARD_MODEL_DIR=/absolute/path/to/prompt-guard-2-86m
