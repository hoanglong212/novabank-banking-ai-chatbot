# Restricted HTTPS review stack (compose.yaml), on a team Linux server.
# Copy to .env.hosted, fill each required value, and run from the repository root:
# docker compose --env-file .env.hosted up -d --build
# See docs/release/DEPLOYMENT.md for DNS, network and backup key setup.

# Required. Hostname only, such as review.example.com.
DEMO_DOMAIN=
ACME_EMAIL=

# Required. Space-separated reviewer IPv4 addresses or CIDRs.
# Example: DEMO_ALLOWED_NETWORKS="203.0.113.10/32 198.51.100.0/24"
DEMO_ALLOWED_NETWORKS=

# Required. Generate a unique persistent value with openssl rand -hex 32.
JWT_SECRET=

# Required. Absolute path of a separate Fernet key file readable by container UID 10001.
BACKUP_KEY_FILE=

# Existing Docker volume holding the single shared SQLite database.
# Default preserves the volume used by previous hosted deployments.
# NOVABANK_SHARED_DATA_VOLUME=novabank-demo_bank-data

# Optional model overrides. Compose uses the same defaults as .env.example.
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b
# GUARD_MODEL=qwen2.5:7b
# EMBEDDING_MODEL=nomic-embed-text:latest
# QUARANTINED_LLM_MODEL=llama3.2:3b
# OLLAMA_IMAGE=ollama/ollama:latest

# Change both only if the private proxy network overlaps an existing network.
# NOVABANK_PROXY_SUBNET=172.31.86.0/28
# NOVABANK_PROXY_IP=172.31.86.2

# Required only with the compose.prompt-guard.yaml overlay.
# PROMPT_GUARD_MODEL_DIR=/absolute/host/path/to/prompt-guard-2-86m
